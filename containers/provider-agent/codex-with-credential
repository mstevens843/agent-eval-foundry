#!/bin/sh
set -eu

mkdir -p "$HOME/.codex"
cp /run/foundry-credential/auth.json "$HOME/.codex/auth.json"
chmod 0600 "$HOME/.codex/auth.json"
if [ -f /run/foundry-credential/config.toml ]; then
  cp /run/foundry-credential/config.toml "$HOME/.codex/config.toml"
  chmod 0600 "$HOME/.codex/config.toml"
fi
exec codex "$@"
