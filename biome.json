{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "overrides": [
    {
      "include": [
        "src/matrix.ts",
        "src/import-swebench.ts",
        "src/foundry/validate.ts",
        "src/foundry/scaffold-check.ts",
        "src/reports/*.ts",
        "test/import-swebench.test.ts",
        "test/foundry-system.test.ts",
        "src/trials/*.ts",
        "src/challenge/*.ts",
        "test/trials.test.ts",
        "src/foundry/kill.ts",
        "src/foundry/evolve.ts",
        "test/evolution.test.ts",
        "src/families/*/*.ts",
        "test/trials-routing.test.ts",
        "src/trials/campaign.ts",
        "src/trials/campaign-run.ts",
        "src/trials/router.ts",
        "src/trials/run.ts",
        "src/trials/agent-bank.ts",
        "src/cli.ts",
        "test/cross-provider.test.ts",
        "src/trials/cross-provider.ts",
        "src/trials/evidence-lifecycle.ts",
        "src/trials/provider-registry.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    }
  ]
}
