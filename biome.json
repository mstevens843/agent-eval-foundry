{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true, "style": { "noNonNullAssertion": "error" } }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "overrides": [
    {
      "include": [
        "src/matrix.ts",
        "src/import-swebench.ts",
        "src/foundry/validate.ts",
        "src/foundry/scaffold-check.ts",
        "src/reports/*.ts",
        "test/import-swebench.test.ts",
        "test/foundry-system.test.ts"
      ],
      "linter": {
        "rules": {
          "complexity": { "useLiteralKeys": "off" }
        }
      }
    }
  ]
}
