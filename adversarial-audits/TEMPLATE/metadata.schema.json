{
  "schema": "agent-eval-foundry/adversarial-attack-record@2",
  "requiredTopLevelKeys": [
    "auditVersion",
    "attackId",
    "campaignId",
    "familyId",
    "status",
    "counts",
    "countabilityReason",
    "challengeHash",
    "verifierHash",
    "attacker",
    "attackSurface",
    "allowedAttackerAccess",
    "forbiddenAttackerAccess",
    "attackerContextFiles",
    "hiddenArtifactsInAttackerContext",
    "transcriptPath",
    "exploitArtifactPath",
    "submittedBypassArtifactPath",
    "verifier",
    "bypassClassification",
    "repair",
    "executionProfile",
    "isolationProfile",
    "exploitArtifact",
    "exploitReplay",
    "triage",
    "startedAt",
    "endedAt",
    "runtimeSeconds",
    "notes"
  ],
  "countedStatuses": ["no-bypass-found", "bypass-found", "exploit-attempt-blocked"],
  "neverCountStatuses": [
    "provider-refusal",
    "infrastructure-error",
    "timeout",
    "invalid-attack",
    "stale-hash",
    "contaminated",
    "superseded"
  ]
}
